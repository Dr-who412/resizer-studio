rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User comments and feedback
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['content', 'category', 'createdAt'])
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 1000;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.authorUid || request.auth.token.email == "mohamedwaleed412@gmail.com");
    }

    // Community feature suggestions & votes
    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create: if request.resource.data.title is string && request.resource.data.title.size() <= 200;
      allow update: if true; // allow voting
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }

    // User personal saved presets
    match /user_presets/{presetId} {
      allow read, write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Official store requirements synchronization cache
    match /store_requirements/{reqId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
